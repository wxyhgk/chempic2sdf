ncher_boundary":{"bootstrap_watchdog":"A minimal external role in its own 64 MiB sibling cgroup owns the absolute deadline, authorization nonce consumption, pidfds/cgroupfds, failure kill path, final independent postcheck, and detached authority marker.","inner":"The sandbox role and every producer/verifier/compiler descendant remain in the 7680 MiB inner sibling cgroup and private namespaces; inner cannot publish, consume authorization, access the marker root, or signal the watchdog.","monitor":"The 448 MiB monitor sibling performs archive, source, stage, certificate, metadata, rename, fsync, and postcheck orchestration but cannot create an authority marker or disable the watchdog.","pre_migration_rule":"Before all three sibling placements are verified, only fixed CLI parsing, authorization-record signature/hash shape checks, cgroup creation, descriptor opening, and conservative VmSize/time capture are allowed.","trust_boundary":"Inner reports never satisfy a gate by assertion; monitor independently validates stage outputs, and watchdog independently validates every required certificate, candidate tree, publication transition, resource event, and marker byte."},"mount_protocol":{"authorized_writable_mounts":[{"maximum_bytes":17179869184,"mountpoint":"/work","purpose":"all source archives, extraction, compiler output, runner output, logs, HOME, TMPDIR, TEMP, and TMP"},{"maximum_bytes":2147483648,"mountpoint":"/publish-stage","purpose":"same-filesystem hidden publication stage only"}],"forbidden_write_probes":["workspace root","source snapshot","/tmp","/var/tmp","/dev/shm","current working directory outside /work","authoritative result root outside /publish-stage"],"mount_namespace_private":true,"mount_setattr_recursive_readonly_required":true,"root_mount_readonly":true,"source_snapshot_readonly_after_extraction":true,"temporary_environment":{"HOME":"/work/home","TEMP":"/work/tmp","TMP":"/work/tmp","TMPDIR":"/work/tmp"},"unexpected_writable_mount_is_whole_run_no_go":true,"write_probe_errno":["EROFS","EACCES"]},"publication_protocol":{"atomicity":"Hidden candidate and renamedCandidate are direct children of /opt/chemgraph/results on the same filesystem; monitor uses renameat2 RENAME_NOREPLACE and fsyncs the parent, but this transition creates no authority.","candidate_path_is_never_authority_by_itself":true,"failure_policy":"Any false or missing gate forbids detached marker creation; dry-run output remains outside /opt/chemgraph/results and cannot have an authority marker.","metadata":{"directories_mode":"0555","files_mode":"0444","gid":0,"hardlinks_forbidden":true,"special_files_forbidden":true,"symlinks_forbidden":true,"uid":0},"ordering":["finish all candidate payload bytes","write final validation status","write non-self-referential resource receipt","write every required first-class certificate","chown root:root","chmod files 0444 and directories 0555","fsync every file","fsync directories bottom-up","compute complete content and metadata roots","verify all semantic isolation stage resource tool source and conformance gates","rename candidate without replacement","fsync results parent","enter renamedCandidate non-authoritative state","monitor reopens and postchecks complete bytes metadata roots and immutability","watchdog independently reopens and postchecks candidate and every certificate","enter postchecked state","watchdog atomically installs detached authority marker without replacement","fsync marker parent","watchdog reopens and validates marker","enter authoritative state"],"post_publication_failure":"Before a valid detached marker exists, quarantine renamedCandidate and fsync both parents. If marker installation or marker postcheck fails, remove/quarantine marker temporary and candidate; never report authority.","root_semantics":"Artifact certificate binds the complete candidate content and metadata tree excluding the detached marker; the detached marker separately binds that exact root and all first-class certificate hashes."},"resource_limits":{"bootstrap_watchdog_memory_max_bytes":67108864,"inner_memory_max_bytes":8053063680,"maximum_published_allocated_bytes":2147483648,"maximum_published_logical_bytes":2147483648,"maximum_temporary_allocated_bytes":17179869184,"maximum_total_memory_bytes":8589934592,"maximum_wall_seconds":1800,"monitor_memory_max_bytes":469762048,"oom_events":0,"physical_cpus":4,"workers_per_semantic_stage":4},"schema_version":"chemgraph-e2-hardened-launcher-contract-v0.2","source_binding":{"dependency_binding":"The complete commit archive is authoritative for v0.4/v0.5 dependencies and P0 files; extracted E2 file bytes are independently compared with the separately frozen E2 subtree archive.","e2_archive":{"file_count":19,"git_tree_object_sha1":"5e7c8b33922326eb0447f24f230019e39e8d9626","sha256":"3385833f32802983b5e84885ecf4ccaaa757f48341a993f576e0bbca8d97e21f","source_file_payload_bytes":142475},"full_commit_archive":{"file_count":1921,"sha256":"d10b4e94073fa45e802b6885436607625b148b09771aff8f042f2db25c33a30d","source_file_payload_bytes":17970849},"launcher_source_freeze":"required after implementation and before any execution; must bind launcher source commit, contract/schema hashes, test hashes, all external tool descriptors, shared-library closure, and kernel/runtime identity","p0_contract_sha256":"e326fc744903b998793746f299232c4225ce3b8648e1abdda7b4e065f06a9402","parent_contract_sha256":"55ddcaacdf851166554ccd586b2a924c0e793f86cc7a6319f98132ef0ffb6b65","source_commit":"5970f316a4cfd30a25d3e89776ab8a4c50742b65","source_freeze_snapshot":{"copy_rule":"read once, hash the same byte buffer, write exclusive private snapshot, fsync, rehash snapshot, and never reread mutable workspace","sha256":"994ae0de25ae47835c8b2bb97e3579555c45d8b79fd41a3a7c195eb9a0c798dc"}},"stage_quiescence":{"daemon_escape_policy":"Every stage supervisor and worker remains in its named child cgroup below inner; migration files are inaccessible in the sandbox; any PID observed outside the assigned subtree is whole-run NO-GO.","fd_snapshot_policy":"At stage completion the watchdog or monitor holds immutable O_PATH/read-only descriptors and full-byte snapshots; later stages cannot reopen mutable producer paths.","handshake":"Stage-complete over a pre-opened SOCK_SEQPACKET channel is only a request: monitor freezes the named child cgroup, waits for frozen=1, verifies the expected supervisor exited, verifies zero descendants and populated=0, snapshots descriptors and bytes, then removes the empty child cgroup before acknowledgement.","required_stages":["producer","verifier_a","verifier_b"],"residual_state_is_terminal_no_go":true,"stage_certificate_required_fields":["record_kind","stage_name","stage_cgroup_id","inner_parent_cgroup_id","supervisor_pid","distinct_worker_pids","worker_pair_assignments","worker_count","pairs_per_worker","pair_coverage","pair_overlap_count","frozen_observed","populated_zero_observed","descendant_count_after_exit","escaped_pid_count","snapshot_descriptor_root_sha256","snapshot_content_root_sha256","cgroup_removed","status"],"worker_proof":"For each semantic stage the monitor must observe exactly four distinct worker PIDs, exactly two assigned pairs per worker, exact coverage of all eight pairs without overlap, and no survivor after stage completion."},"training_authorized":false,"wall_protocol":{"clock":"CLOCK_MONOTONIC_RAW","deadline_owner":"bootstrap_watchdog","deadline_start":"The external watchdog arms an absolute timerfd at start+1800 seconds before authorization ledger consumption and before any archive, source, tool, output, rename, fsync, postcheck, or marker byte is processed.","hard_kill":"timerfd expiration causes the surviving watchdog to write cgroup.kill to inner and monitor sibling cgroups, wait for both populated=0, quarantine renamedCandidate, and permanently forbid marker creation for the nonce.","included_operations":["pre-exec migration accounting","authorization ledger consumption","archive generation","safe extraction","tool and source closure verification","compilation","producer","verifier_a","verifier_b","stage quiescence snapshots","artifact copy","certificate and validation writes","chown/chmod","all fsync operations","candidate rename","results parent fsync","monitor postcheck","watchdog postcheck","detached marker write and fsync","marker parent fsync","marker reopen and validation"],"monitor_cannot_extend_cancel_or_rearm":true,"no_extension":true,"polling_only_forbidden":true,"wall_upper_rule":"ceil(CLOCK_MONOTONIC_RAW elapsed at final validated marker reopen); no reserve or publication exception may extend the absolute deadline"},"watchdog_protocol":{"deadline_owner":"bootstrap_watchdog","event_sources":["absolute_timerfd","monitor_pidfd","monitor_memory_events","inner_memory_events","monitor_control_socket"],"hard_failure_actions":["write inner/cgroup.kill","write monitor/cgroup.kill","wait until inner and monitor cgroup.events populated=0","quarantine any renamedCandidate","remove or quarantine any unvalidated marker temporary","record failure outside authority marker root","forbid authority marker creation"],"monitor_failure_events":["pidfd exit before authority-complete acknowledgement","nonzero exit","oom increment","oom_kill increment","oom_group_kill increment","control channel EOF","protocol violation"],"monitor_report_is_not_a_gate":true,"polling_is_insufficient":true,"required_handles_opened_before_monitor_spawn":["absolute_timerfd","monitor_pidfd immediately after fork","bootstrap_watchdog cgroupfd","monitor cgroupfd","inner cgroupfd","authorization ledger dirfd","results dirfd","marker dirfd","quarantine dirfd"],"success_condition":"Only after independent watchdog postcheck, detached marker install, marker-parent fsync, marker reopen, and full marker validation may watchdog send authority-complete and permit normal monitor exit.","watchdog_blocking_operations_forbidden":["unbounded wait","network I/O","path traversal without frozen dirfd","monitor-controlled deadline extension"]}}
