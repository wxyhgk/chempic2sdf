{
  "$id": "challenge_spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "antialias_profiles": {
      "const": ["binary_1x", "box_2x2", "box_4x4"]
    },
    "canvas": {
      "const": [768, 768]
    },
    "caps": {
      "const": ["butt", "round", "square"]
    },
    "challenge_id": {
      "const": "chemgraph-hidden-v0-4"
    },
    "joins": {
      "const": ["round"]
    },
    "line_width_pixels": {
      "const": [1, 2, 3, 4, 5, 6, 7, 8, 9]
    },
    "maximum_attempts": {
      "const": 32
    },
    "pack_id": {
      "pattern": "^pack-[ab]$",
      "type": "string"
    },
    "prng": {
      "const": "hmac-sha256-counter-v1"
    },
    "profile": {
      "enum": ["smoke", "full"]
    },
    "q_format": {
      "const": "Q16.16"
    },
    "quotas": {
      "additionalProperties": false,
      "properties": {
        "c1": {"minimum": 4, "type": "integer"},
        "c2": {"minimum": 4, "type": "integer"},
        "c3": {"minimum": 4, "type": "integer"},
        "c4": {"minimum": 4, "type": "integer"},
        "s1": {"minimum": 4, "type": "integer"},
        "s2": {"minimum": 4, "type": "integer"},
        "s3": {"minimum": 4, "type": "integer"},
        "s4": {"minimum": 4, "type": "integer"},
        "s5": {"minimum": 4, "type": "integer"},
        "s6": {"minimum": 4, "type": "integer"},
        "s7": {"minimum": 4, "type": "integer"},
        "s8": {"minimum": 4, "type": "integer"}
      },
      "required": ["s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "c1", "c2", "c3", "c4"],
      "type": "object"
    },
    "reflections": {
      "const": ["none", "x", "y"]
    },
    "rotations": {
      "const": [
        [[1, 1], [0, 1]],
        [[3, 5], [4, 5]],
        [[5, 13], [12, 13]],
        [[8, 17], [15, 17]],
        [[0, 1], [1, 1]],
        [[-3, 5], [4, 5]],
        [[5, 13], [-12, 13]],
        [[-8, 17], [-15, 17]]
      ]
    },
    "scales": {
      "const": [[1, 2], [5, 8], [3, 4], [1, 1], [5, 4], [3, 2], [2, 1]]
    },
    "schema_version": {
      "const": "chemgraph-hidden-generator-v0.4"
    }
  },
  "required": [
    "schema_version", "challenge_id", "pack_id", "profile", "canvas", "q_format",
    "prng", "quotas", "line_width_pixels", "caps", "joins", "antialias_profiles",
    "rotations", "reflections", "scales", "maximum_attempts"
  ],
  "title": "Frozen generator configuration written as config.json",
  "type": "object"
}
