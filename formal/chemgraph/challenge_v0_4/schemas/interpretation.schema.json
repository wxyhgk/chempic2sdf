{
  "$id": "interpretation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atoms": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "atom_id": {
            "pattern": "^a-[0-9]{4}$",
            "type": "string"
          },
          "chemical_label": {
            "minLength": 1,
            "type": "string"
          },
          "formal_charge": {
            "maximum": 8,
            "minimum": -8,
            "type": "integer"
          },
          "position_q16": {
            "$ref": "common.schema.json#/$defs/point_q16"
          }
        },
        "required": [
          "atom_id",
          "chemical_label",
          "formal_charge",
          "position_q16"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "bonds": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "begin_atom_id": {
            "pattern": "^a-[0-9]{4}$",
            "type": "string"
          },
          "bond_id": {
            "pattern": "^b-[0-9]{4}$",
            "type": "string"
          },
          "end_atom_id": {
            "pattern": "^a-[0-9]{4}$",
            "type": "string"
          },
          "order": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "primitive_ids": {
            "items": {
              "pattern": "^p-[0-9]{6}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "bond_id",
          "begin_atom_id",
          "end_atom_id",
          "order",
          "primitive_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "expected_decode_kind": {
      "enum": [
        "strict_graph",
        "graph_ambiguity",
        "stroke_role_ambiguity"
      ]
    },
    "ink_program_id": {
      "pattern": "^ink-[0-9]{8}$",
      "type": "string"
    },
    "interpretation_id": {
      "pattern": "^int-[0-9]{8}-[0-9]{2}$",
      "type": "string"
    },
    "primitive_roles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "owner_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "primitive_id": {
            "pattern": "^p-[0-9]{6}$",
            "type": "string"
          },
          "role": {
            "enum": [
              "bond_lane",
              "atom_glyph",
              "marker",
              "decoration",
              "unassigned"
            ]
          }
        },
        "required": [
          "primitive_id",
          "role",
          "owner_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "hidden-interpretation-0.4"
    }
  },
  "required": [
    "schema_version",
    "interpretation_id",
    "ink_program_id",
    "expected_decode_kind",
    "atoms",
    "bonds",
    "primitive_roles"
  ],
  "title": "Hidden semantic interpretation of one InkProgram",
  "type": "object"
}
