{
  "$id": "https://chemgraph.local/schemas/carrier-candidate-input-v0.3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "JSON shape only. An independent validator must enforce canonical 768x768 grayscale PNG bytes. Each anonymous input permits exactly one authoritative proposer run and carries no replay or identity token.",
  "additionalProperties": false,
  "properties": {
    "image": {
      "additionalProperties": false,
      "properties": {
        "bytes_base64": {
          "maxLength": 5592408,
          "minLength": 12,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "type": "string"
        },
        "format": {"const": "png"},
        "height": {"const": 768},
        "width": {"const": 768}
      },
      "required": ["bytes_base64", "format", "height", "width"],
      "type": "object"
    },
    "schema_version": {"const": "chemgraph-carrier-candidate-input-v0.3"},
    "training_authorized": {"const": false}
  },
  "required": ["image", "schema_version", "training_authorized"],
  "title": "Carrier candidate set proposer input v0.3",
  "type": "object"
}
